# Copy to .env and fill in. Tokens are never printed or written to CSV.

VIX_GRAPHQL_ENDPOINT=https://client-api.vix.com/gql/v2
# Staging (often needed when token issuer is id-stg):
# VIX_GRAPHQL_ENDPOINT=https://client-api.stg.vix.tv/gql/v2

# Default auth profile (--auth-profile default)
AUTH_TOKEN=
X_VIX_USER_TOKEN=

# WC / alternate auth profile (--auth-profile wc or --auth-profile-map /ondemandpluswc=wc)
AUTH_TOKEN_WC=
X_VIX_USER_TOKEN_WC=

VIX_APP_VERSION=5.0.0
# Prefer web so layout matches vix.com (not mobile/android "Hero Móvil").
# Note: x-vix-device-type must be "desktop" for web — "web" returns MALFORMED_REQUEST.
VIX_DEVICE_TYPE=desktop
VIX_PLATFORM=web
VIX_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
# Catalog country for CMS Mexico. JWT country=US without this header returns the US rail.
VIX_COUNTRY=MX
VIX_ACCEPT_LANGUAGE=es-MX,es;q=0.9
# Statsig / gated experience override (sent as x-vix-installation-id etc.)
# VIX_INSTALLATION_ID=
# Optional: paste full GraphQL query as one line, or use --query-file instead
# VIX_GRAPHQL_QUERY=
